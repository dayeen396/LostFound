{
  "name": "du-lost-and-found",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual lost and found platform for the University of Dhaka community",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "db:migrate": "node server/src/migrate.js",
    "db:seed": "node server/src/seed.js",
    "test": "node --test server/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "multer": "^2.0.2",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
